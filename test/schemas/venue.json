{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "name", "capacity"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "city": { "type": "string" },
    "capacity": { "type": "integer", "minimum": 20, "maximum": 1200 },
    "accessible": { "type": "boolean" }
  }
}
